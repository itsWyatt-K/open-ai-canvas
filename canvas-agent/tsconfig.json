{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"]
  },
  "include": [
    "src/modules/**/*.ts",
    "src/yingce-server-executor.ts",
    "test/exit-gates/**/*.ts",
    "test/golden-tasks/**/*.ts"
  ]
}
