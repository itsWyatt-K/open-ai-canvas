            "type": "string"
          },
          "title": {
            "description": "屏主题（可空，空则保留原值）",
            "type": "string"
          }
        },
        "required": [
          "productId",
          "slotId"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
  {
