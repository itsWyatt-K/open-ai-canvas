          },
          "productId": {
            "description": "商品任务 ID",
            "type": "string"
          },
          "prompt": {
            "description": "画面描述/生图提示词（可空，空则保留原值）",
            "type": "string"
          },
          "promptOverride": {
            "description": "完整提示词覆盖（非空时最高优先；传空字符串表示清除覆盖）",
